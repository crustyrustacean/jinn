{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinn.dev/plugin-api/v1/plugin-api.schema.json",
  "title": "jinn plugin wire contract v1",
  "description": "Every NDJSON line crossing the plugin boundary is an Envelope. Hand-maintained mirror of the jinn-plugin-api crate types; a drift test fails when the two disagree.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Wire protocol major version."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Sender-assigned monotonic sequence number (per direction)."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds when the sender produced the message."
    },
    "type": {
      "type": "string",
      "description": "Message tag (flattened into the envelope by serde)."
    }
  },
  "required": [
    "v",
    "seq",
    "ts",
    "type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "protocol_version",
          "name"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "hello"
          },
          "protocol_version": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "subscriptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "set_theme_entries"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "themes"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "set_theme_entries"
          },
          "themes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/themeDef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "set_persona_entries"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "personas"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "set_persona_entries"
          },
          "personas": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/personaDef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "welcome"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "protocol_version",
          "plugin_id",
          "http_allowed"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "welcome"
          },
          "protocol_version": {
            "type": "integer"
          },
          "plugin_id": {
            "type": "string"
          },
          "read_dirs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_dirs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "http_allowed": {
            "type": "boolean"
          },
          "config": {}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_call_event"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id",
          "tool_call_id",
          "name",
          "arguments"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "tool_call_event"
          },
          "session_id": {
            "type": "string"
          },
          "tool_call_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "string",
            "description": "The tool call's arguments as a JSON string."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_result_event"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id",
          "tool_call_id",
          "name",
          "content",
          "success"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "tool_result_event"
          },
          "session_id": {
            "type": "string"
          },
          "tool_call_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Execution output; the untruncated full_content when truncation occurred."
          },
          "success": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "turn_end_event"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id",
          "final_answer"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "turn_end_event"
          },
          "session_id": {
            "type": "string"
          },
          "final_answer": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "push_citations"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id",
          "citations"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "push_citations"
          },
          "session_id": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pluginCitation"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancel_stream"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "cancel_stream"
          },
          "session_id": {
            "type": "string",
            "description": "The session whose active stream should be canceled."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "insert_system_entry"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "v",
          "seq",
          "ts",
          "type",
          "session_id",
          "text"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "description": "Wire protocol major version."
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Sender-assigned monotonic sequence number (per direction)."
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix epoch milliseconds when the sender produced the message."
          },
          "type": {
            "const": "insert_system_entry"
          },
          "session_id": {
            "type": "string",
            "description": "The session to append the system entry to."
          },
          "text": {
            "type": "string",
            "description": "The system entry text."
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "$defs": {
    "pluginCitation": {
      "type": "object",
      "required": [
        "url",
        "title"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "The source URL (http/https only; anything else is dropped by the host)."
        },
        "title": {
          "type": "string",
          "description": "Human-readable title for the source."
        },
        "content": {
          "type": "string",
          "description": "Optional snippet text."
        }
      },
      "additionalProperties": false
    },
    "themeDef": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique theme name. \"default\" is reserved by the host."
        },
        "description": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "description": "Slot key to color string. Slot keys are the snake_case core Theme field names; color strings accept ANSI name, ANSI code, hex, or RGB form.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "personaDef": {
      "type": "object",
      "required": [
        "name",
        "body"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique persona name."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short picker description, if the source declared one."
        },
        "body": {
          "type": "string",
          "description": "The persona body — system prompt text."
        }
      },
      "additionalProperties": false
    }
  }
}
