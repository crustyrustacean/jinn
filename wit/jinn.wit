// jinn plugin component contract.
//
// This is the single source of truth for the plugin/host boundary. Plugins are
// WASM components authored in Rust (via `jinn-guest-pdk`) that implement the
// `plugin` world (exporting `hooks` + any plugin-defined async hooks) and
// import the `host` interface for capabilities.
//
// Design rules:
//   * Host-known shapes (hook ctx, commands, request envelopes) cross as native
//     WIT records/variants — no serialization at those edges.
//   * The opaque state bag (`plugin-data`, `global-data`) crosses as `list<u8>`.
//     The host is format-blind; the plugin owns the codec (PDK default: postcard).
//   * A component only exports the hooks it cares about. The host probes
//     `instance.exports().get("<hook>")` and skips absent exports — this is how
//     plugin-defined async hooks (e.g. `on-enrich`) work: they are NOT declared
//     here. Their names come from a keybind's `action` field.

package jinn:plugin@0.1.0;

// ─── Worlds ─────────────────────────────────────────────────────────────

/// The world a jinn plugin component targets. Plugins import `host` for
/// capabilities and export `hooks` for the lifecycle/render entry points.
world plugin {
    import host;
    export hooks;
}

// ─── Host interface (IMPORTS — what a plugin calls) ─────────────────────

interface host {
    use types.{bag, command, llm-oneshot-req, llm-resp, request-error,
               create-session-req, create-session-resp};

    /// Fire-and-forget a typed domain command. The host translates the WIT
    /// `command` variant to a domain `BridgeClosure` and forwards it to the bus.
    emit: func(cmd: command);

    /// History-less one-shot LLM call. Inherits the session's provider+model.
    /// Awaits the host's future (suspends the component) and resumes with the
    /// response. Named via `task` so it can be cancelled by `cancel-task`.
    request-llm-oneshot: async func(
        req: llm-oneshot-req,
    ) -> result<llm-resp, request-error>;

    /// Create a new session as a child of `parent-session-id`. Awaits the host
    /// and resumes with the new session id. Used by the judge plugin.
    create-session: async func(
        req: create-session-req,
    ) -> result<create-session-resp, request-error>;

    /// Cancel a named in-flight request (matched against the `task` field).
    cancel-task: func(name: string);

    // ── Host-owned state bags ──
    //
    // The plugin's persistent state (survives restarts, persisted by the host
    // to SQLite keyed by instance id). Opaque bytes; the plugin owns the codec.

    /// Read this plugin instance's current bag, or `none` if empty.
    get-plugin-data: func() -> option<bag>;

    /// Replace this plugin instance's bag.
    set-plugin-data: func(data: bag);

    // ── Global data — cross-instance coordination channel ──
    //
    // A string-keyed bag shared across ALL plugin instances and plugins. Used
    // by the judge's aggregation (verdicts posted under a shared origin key;
    // the last-to-finish reads and merges). Read-modify-write is safe because
    // hooks serialize through a single plugin thread.

    /// Read the live value under `key`, or `none` if absent.
    get-global-data: func(key: string) -> option<bag>;

    /// Write (replace) the value under `key`. `none` deletes it.
    set-global-data: func(key: string, data: option<bag>);
}

// ─── Hooks interface (EXPORTS — what a plugin provides) ─────────────────

interface hooks {
    use types.{manifest, session-ctx, attach-ctx, turn-end-ctx,
               task-list-ctx, badge-ctx, keybind-trigger-ctx,
               submit-intercept-ctx, badge-directive, intercept-outcome,
               keybind-result, session-preview-ctx, trigger-ctx, tool-ctx};

    /// Declares the plugin's name, description, keybinds, and tools. Called
    /// once per instantiation to cache metadata. MUST be cheap and
    /// side-effect-free (must not call host imports). Replaces the Lua
    /// header-comment description + `M.keybinds` + `M.tools`.
    get-manifest: func() -> manifest;


    /// Fires once at app startup.
    on-app-started: async func(ctx: session-ctx);

    /// Fires when a new session is created.
    on-session-created: async func(ctx: session-ctx);

    /// Fires when this plugin instance is attached to a session. Use it to
    /// register this instance in shared global-data keys (e.g. increment a
    /// participant count). Only the newly-attached instance receives it.
    on-attach: async func(ctx: attach-ctx);

    /// Fires when this plugin instance is detached. Runs BEFORE the registry
    /// is rebuilt, so the instance can clean up shared global-data keys.
    on-detach: async func(ctx: attach-ctx);

    /// Fires when a session transitions to Idle (turn complete).
    on-turn-end: async func(ctx: turn-end-ctx);

    /// Fires when the user submits a message (session transitions to Sending).
    on-user-submit: async func(ctx: session-ctx);

    /// Fires whenever a session's task list is mutated.
    on-task-list-updated: async func(ctx: task-list-ctx);

    // ── Plugin-defined async triggers ──
    //
    // Unlike the well-known hooks above (each a named export), plugin-defined
    // async hooks (declared by a keybind's `action` field, e.g. "on-enrich")
    // cannot be individually exported — a WASM component only exports
    // WIT-declared functions. They funnel through this single dispatch export.
    // The host passes the keybind's `action` string through verbatim; it never
    // hard-codes any trigger name. The plugin matches `action` internally.
    run-trigger: async func(action: string, ctx: trigger-ctx);

    // ── Plugin-defined tools ──
    //
    // Same model as `run-trigger`: a plugin's declared tools (manifest `tools`
    // list) are discovered by name at runtime. Since a WASM component can't
    // export arbitrary-named functions, tool calls funnel through this single
    // dispatch export. The host passes the tool `name` (from the manifest)
    // verbatim with the LLM-provided JSON args; the plugin matches internally.
    //
    // The returned `string` is the tool result content fed back to the LLM
    // (analogous to built-in tool results). Empty string is a valid no-content
    // response.
    run-tool: async func(name: string, args: string, ctx: tool-ctx) -> string;

    // ── Sync render hooks (run on the render thread) ──
    //
    // These run directly on the render-thread store (zero channel hops). They
    // must NOT call async host imports (no `request-llm-oneshot`,
    // `create-session`). To kick off async work, use `emit(fire-async-hook)`.

    on-chat-input-badges-render: func(
        ctx: badge-ctx,
    ) -> option<badge-directive>;

    /// Sync veto hook. A plugin returns `some(keybind-result)` to veto or allow
    /// firing the async hook named by the keybind's `action` field.
    on-keybind-trigger: func(
        ctx: keybind-trigger-ctx,
    ) -> option<keybind-result>;

    /// Sync hook for sidebar session preview when the cursor is on a plugin entry.
    on-session-preview: func(
        ctx: session-preview-ctx,
    ) -> option<string>;

    /// Sync hook fired after a submit-family intent resolves but before its
    /// commands dispatch. Plugins may block, pass, or replace the commands.
    on-submit-intercept: func(
        ctx: submit-intercept-ctx,
    ) -> option<intercept-outcome>;
}

// ─── Types ──────────────────────────────────────────────────────────────

interface types {
    // ── Primitive aliases ──

    /// A session identifier. jinn session ids are opaque strings (`SessionId`).
    type session-id = string;

    /// A plugin instance identifier. Distinct for duplicate attachments of the
    /// same plugin to one session (`PluginInstanceId`).
    type instance-id = string;

    /// Opaque state bag bytes. The host never inspects the contents; the plugin
    /// serializes/deserializes via its PDK codec (postcard by default).
    type bag = list<u8>;

    // ── Manifest ──

    record manifest {
        /// Human-readable description (shown in the plugin picker).
        description: option<string>,
        /// Declared keybinds (replaces Lua `M.keybinds`).
        keybinds: list<keybind>,
        /// Declared plugin-defined tools (replaces Lua `M.tools`).
        tools: list<tool-decl>,
    }

    record keybind {
        /// Keymap scope, e.g. `"Input"`. Must match `Scope::Display` casing.
        scope: string,
        /// Key chord, e.g. `"<M-e>"`.
        keys: string,
        /// The async hook name to fire when pressed (e.g. `"on-enrich"`).
        /// This is the lookup name used by runtime export discovery; the host
        /// never hard-codes it.
        action: string,
        /// Help text for the which-key popup.
        description: string,
    }

    /// A tool declared by a plugin. The handler is a typed export named after
    /// the tool, discovered at runtime (same model as hooks).
    record tool-decl {
        name: string,
        description: string,
        /// Simplified parameter DSL entries (expanded to JSON Schema by host).
        parameters: list<tool-param>,
        /// Whether the tool is global or session-attached.
        scope: tool-scope,
    }

    record tool-param {
        name: string,
        /// `"string"`, `"number"`, or `"boolean"`.
        param-type: string,
        description: string,
    }

    variant tool-scope {
        global,
        attached,
    }

    // ── Hook ctx records ──

    /// Base fields shared by lifecycle hooks. Carries session scoping for
    /// `plugin-data` lookups plus the plugin's own identity.
    record session-ctx {
        session-id: session-id,
        /// Parent session id, if this is a child session. None for top-level.
        parent-session-id: option<session-id>,
        /// This plugin instance's stable id.
        instance-id: instance-id,
        /// This plugin's name (for self-targeting actions like disable-plugin).
        plugin-name: string,
    }

    /// Used by `on-attach` / `on-detach`.
    record attach-ctx {
        session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
    }

    /// Used by `on-turn-end`.
    record turn-end-ctx {
        session-id: session-id,
        parent-session-id: option<session-id>,
        instance-id: instance-id,
        plugin-name: string,
        /// Monotonic turn number derived from the session's history
        /// (count of assistant entries). Lets a plugin detect that
        /// another instance already claimed this turn.
        turn: u32,
    }

    /// Used by `on-task-list-updated`.
    record task-list-ctx {
        session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
        /// The task list rendered as text (phases + tasks + blockers).
        task-list: string,
        completed: u32,
        total: u32,
        /// True only when the list is non-empty AND no phase has pending work.
        is-complete: bool,
    }

    /// Used by `on-chat-input-badges-render`.
    record badge-ctx {
        session-id: session-id,
        /// The session currently in focus (preview target).
        active-session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
        /// Current scope mode as a lowercase string (`"input"`, `"normal"`, ...).
        mode: string,
        /// Flat dictionary of every theme field name mapped to itself. Pass any
        /// key as a segment's `style` to resolve it against the active theme.
        theme-styles: list<theme-style>,
    }

    record theme-style {
        /// The theme field name (also the value); e.g. `"streaming"`.
        name: string,
    }

    /// Used by `on-keybind-trigger`.
    record keybind-trigger-ctx {
        session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
        /// The hook name to fire (from the keybind's `action`).
        hook: string,
        /// The current chat-input draft at trigger time.
        text: string,
        /// The plugin whose keybind was pressed (self-select hint).
        keybound-plugin: string,
    }

    /// Used by `run-trigger` (plugin-defined async hooks like on-enrich).
    /// `text` is the chat-input draft at trigger time; carried through the
    /// sync `on-keybind-trigger` veto and into the async fire.
    record trigger-ctx {
        session-id: session-id,
        parent-session-id: option<session-id>,
        instance-id: instance-id,
        plugin-name: string,
        text: string,
    }

    /// Used by `run-tool` (plugin-defined tool handlers, e.g. judgment_passed).
    /// `session-id` is the child/tool session's own id (unique per verdict);
    /// `parent-session-id` is the origin the tool routes results back to.
    record tool-ctx {
        session-id: session-id,
        parent-session-id: option<session-id>,
        instance-id: instance-id,
        plugin-name: string,
    }
    /// Used by `on-submit-intercept`.
    record submit-intercept-ctx {
        session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
        /// The current chat-input draft at submit time.
        input-text: string,
    }

    /// Used by `on-session-preview`.
    record session-preview-ctx {
        session-id: session-id,
        instance-id: instance-id,
        plugin-name: string,
    }

    // ── Return types ──

    record badge-directive {
        /// Named location, e.g. `"input_badge"`.
        slot: string,
        /// Styled segments drawn left-to-right within the slot.
        segments: list<badge-segment>,
    }

    record badge-segment {
        text: string,
        /// Optional constrained style name resolved by the host against the
        /// active theme. None yields the default style.
        style: option<string>,
    }

    /// Result of the `on-keybind-trigger` veto.
    variant keybind-result {
        /// Allow the async action to fire.
        run,
        /// Veto the async action (e.g. cancel an in-flight request instead).
        skip,
    }

    /// Outcome of `on-submit-intercept`.
    variant intercept-outcome {
        /// Drop the pending commands.
        block,
        /// Leave the pending commands unchanged.
        pass,
        /// Replace the pending commands with `commands`.
        replace(list<command>),
    }

    // ── Commands (the 9 verbs, closed variant) ──
    //
    // Each multi-field command wraps its payload in a record (WIT variant cases
    // carry exactly one type). Maps 1:1 to the current 9 Lua verbs.

    variant command {
        push-chat-entry(push-chat-entry-cmd),
        enqueue-user-message(enqueue-user-message-cmd),
        set-chat-input(set-chat-input-cmd),
        set-chat-input-enabled(set-chat-input-enabled-cmd),
        disable-plugin(disable-plugin-cmd),
        enable-plugin(enable-plugin-cmd),
        set-managed-session(set-managed-session-cmd),
        reset-session(reset-session-cmd),
        fire-async-hook(fire-async-hook-cmd),
    }

    record push-chat-entry-cmd {
        session-id: session-id,
        kind: push-entry-kind,
    }

    variant push-entry-kind {
        /// A system-generated message (status updates, greetings).
        system(string),
        /// A transient indicator (auto-dismissed, not sent to the LLM).
        transient(string),
        /// An error message displayed prominently.
        error(string),
    }

    record enqueue-user-message-cmd {
        session-id: session-id,
        text: string,
    }

    record set-chat-input-cmd {
        session-id: session-id,
        text: string,
    }

    record set-chat-input-enabled-cmd {
        session-id: session-id,
        enabled: bool,
    }

    record disable-plugin-cmd {
        session-id: session-id,
        plugin-name: string,
        instance-id: instance-id,
    }

    record enable-plugin-cmd {
        session-id: session-id,
        plugin-name: string,
        instance-id: instance-id,
    }

    record set-managed-session-cmd {
        session-id: session-id,
        plugin-name: string,
        managed-session-id: session-id,
        instance-id: instance-id,
    }

    record reset-session-cmd {
        session-id: session-id,
    }

    record fire-async-hook-cmd {
        session-id: session-id,
        /// The async hook name to fire.
        hook: string,
        /// Optional text forwarded into the async hook ctx.
        text: option<string>,
    }

    // ── Request contracts ──

    record llm-oneshot-req {
        session-id: session-id,
        system: string,
        prompt: string,
        /// True to persist the one-shot session to the store.
        persist: bool,
        /// True to run with no tools and tool_loop_disabled.
        disable-tool-loop: bool,
        /// Hard upper bound on the await, in milliseconds.
        timeout-ms: option<u32>,
        /// Named task so it can be cancelled by `cancel-task`.
        task: option<string>,
    }

    record llm-resp {
        text: string,
    }

    record create-session-req {
        parent-session-id: session-id,
        automated: bool,
        persist: bool,
        inherit-tools: bool,
        /// Names of attachable tools to resolve into the child.
        tools: list<string>,
    }

    record create-session-resp {
        session-id: session-id,
    }

    /// Why a request failed.
    variant request-error {
        /// The await was cancelled via `cancel-task`.
        cancelled,
        /// Any other failure (LLM error, malformed payload, unknown name).
        other(string),
    }
}
